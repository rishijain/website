# Cloudflare Workers static assets. NOTE: when several rules match a path, Cloudflare
# JOINS values for the same header instead of overriding, so no header is set by two
# rules below. HTML, robots.txt, sitemap and rss.xml get no explicit Cache-Control and
# fall back to Cloudflare's default (revalidate on every request), which is what we want.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed build output: cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable, unhashed filenames: moderate cache (1 day).
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-default.png
  Cache-Control: public, max-age=86400
/resume.pdf
  Cache-Control: public, max-age=86400

# No Content-Security-Policy: add one only after accounting for the Cloudflare Web Analytics beacon.
