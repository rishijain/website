---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IndexRow from '../components/IndexRow.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import PostRow from '../components/PostRow.astro';
import { getListedPosts, year, personNode, siteCreated, siteUpdated } from '../lib';

const posts = (await getListedPosts()).slice(0, 3);
const projects = (await getCollection('projects')).filter((p) => p.data.featured);
const talks = (await getCollection('talks')).filter((t) => t.data.featured);
// Selected work: featured projects and talks, newest first, capped at 3.
const selected = [
  ...projects.map((p) => ({ y: p.data.year, title: p.data.title, summary: p.data.summary, meta: 'Project', href: '/projects' })),
  ...talks.map((t) => ({ y: year(t.data.date), title: t.data.title, summary: t.data.conference, meta: 'Talk', href: '/talks' })),
]
  .sort((a, b) => b.y - a.y)
  .slice(0, 3);

const base = Astro.site!.origin;
const graph = [
  personNode(base),
  {
    '@type': 'WebSite',
    '@id': `${base}/#website`,
    name: site.name,
    url: `${base}/`,
  },
  {
    '@type': 'ProfilePage',
    '@id': `${base}/#profilepage`,
    url: `${base}/`,
    name: `${site.name} - ${site.jobTitle}`,
    isPartOf: { '@id': `${base}/#website` },
    mainEntity: { '@id': `${base}/#person` },
    dateCreated: siteCreated,
    dateModified: siteUpdated,
  },
];
---

<Base title={`${site.name} - ${site.jobTitle}`} description={site.entitySentence}>
  <JsonLd slot="head" graph={graph} />
  <h1>{site.name}</h1>
  <p class="lede">{site.entitySentence}</p>
  <p>{site.bio}</p>
  <p class="mut">
    I use AI tools to help draft and edit this site. I review everything published here.
  </p>

  <h2 class="section-label">Selected work</h2>
  <ul class="rows">
    {selected.map((s) => <IndexRow label={String(s.y)} title={s.title} summary={s.summary} meta={s.meta} href={s.href} />)}
  </ul>

  <h2 class="section-label">Latest posts</h2>
  <ul class="rows">
    {posts.map((p) => <PostRow post={p} />)}
  </ul>
  <p><a href="/blog">All posts</a></p>
</Base>
