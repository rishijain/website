---
import Base from '../../../layouts/Base.astro';
import PostRow from '../../../components/PostRow.astro';
import TagChips from '../../../components/TagChips.astro';
import { site, pageTitle } from '../../../data/site';
import { TAG_IDS, TAG_NAMES } from '../../../data/tags';
import { getListedPosts } from '../../../lib';

export async function getStaticPaths() {
  const posts = await getListedPosts();
  const used = TAG_IDS.filter((t) => posts.some((p) => p.tags.includes(t)));
  return used.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.tags.includes(tag)), used },
  }));
}
const { tag } = Astro.params as { tag: (typeof TAG_IDS)[number] };
const { posts, used } = Astro.props;
---

<Base title={pageTitle(`Posts tagged ${TAG_NAMES[tag]}`)} description={`Posts by ${site.name} tagged ${TAG_NAMES[tag]}.`}>
  <h1>{TAG_NAMES[tag]}</h1>
  <TagChips tags={used} current={tag} />
  <ul class="rows">
    {posts.map((p) => <PostRow post={p} />)}
  </ul>
  <p><a href="/blog">All posts</a></p>
</Base>
