---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import TagChips from '../../components/TagChips.astro';
import { site, pageTitle } from '../../data/site';
import { TAG_IDS } from '../../data/tags';
import { getListedPosts, year } from '../../lib';

const posts = await getListedPosts();
const usedTags = TAG_IDS.filter((t) => posts.some((p) => p.tags.includes(t)));
const years = [...new Set(posts.map((p) => year(p.date)))];
---

<Base title={pageTitle('Blog')} description={`Posts by ${site.name} on AI agents, Rails, speaking and building products.`}>
  <h1>Blog</h1>
  <TagChips tags={usedTags} />
  {
    years.map((y) => (
      <>
        <h2 class="year-label">{y}</h2>
        <ul class="rows">
          {posts.filter((p) => year(p.date) === y).map((p) => <PostRow post={p} />)}
        </ul>
      </>
    ))
  }
  <p class="mut"><a href="/rss.xml">RSS feed</a> (posts written on this site only)</p>
</Base>
