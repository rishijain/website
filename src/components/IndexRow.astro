---
// One ruled row: small monospace label/date, bold title, monospace tag column.
// Renders a link when `href` is given, otherwise a plain row.
interface Props {
  href?: string;
  label?: string;
  datetime?: string;
  title: string;
  meta?: string;
  summary?: string;
  newTab?: boolean;
}
const { href, label, datetime, title, meta, summary, newTab } = Astro.props;
const tabAttrs = href && newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const Tag = href ? 'a' : 'div';
---

<li class="row-item">
  <Tag class="row" href={href} {...tabAttrs}>
    <span class="num">
      {datetime ? <time datetime={datetime}>{label}</time> : label}
    </span>
    <span class="row-main">
      <b>{title}</b>
      {summary && <span class="row-summary">{summary}</span>}
      <slot />
    </span>
    {meta && <span class="tg">{meta}</span>}
  </Tag>
</li>
